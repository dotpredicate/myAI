{
  "name": "myai-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "myAI web front-end",
  "scripts": {
    "build": "rm -rf public/js && tsc -p .",
    "dev": "tsc -p . --watch",
    "check": "tsc -p . --noEmit",
    "lint": "oxlint --type-aware -W suspicious -W typescript/no-unnecessary-condition -A typescript/no-floating-promises public/ts"
  },
  "devDependencies": {
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
