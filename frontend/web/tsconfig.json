{
  "compilerOptions": {
    "rootDir": "ts",
    "outDir": "js",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "sourceMap": true,
    "inlineSources": false,
    "allowJs": false
  },
  "include": ["ts/**/*.ts"]
}
